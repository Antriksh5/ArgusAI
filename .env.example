# ArgusAI environment variables
# Copy this file to .env and fill in your values.
# .env is in .gitignore — never commit it.

# Full PostgreSQL connection URL (takes precedence over individual vars below)
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://argus_app:CHANGE_ME@localhost:5432/argus_db

# --- Alternatively, set individual parts (used by docker-compose) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=argus_db
DB_USER=argus_app
DB_PASSWORD=CHANGE_ME
